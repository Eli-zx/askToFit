# ===== 复制为 .env 后按需修改 =====

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=asktofit
# SSE 流式请求会在返回前主动归还连接；演示并发注册时可临时调大
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=asktofit
MILVUS_COLLECTION=fitrag

# 大模型：不填写则使用当前进程环境变量
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseekv4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地模型路径（相对路径按项目根目录解析，部署时可整体拷贝 models/）
BGE_M3_PATH=models/bge-m3
BGE_RERANKER_PATH=models/bge-reranker-v2-m3
INTENT_MODEL_PATH=models/intent-bert
EMBEDDING_DEVICE=cpu
# 启动时校验模型目录；首次部署未下载模型可临时设为 false
VALIDATE_MODELS_ON_STARTUP=true
# 模型保活间隔（秒）：定期跑一次极短推理，避免长时间空闲后首个请求冷启动过慢；0 关闭
MODEL_WARMUP_INTERVAL_SECONDS=600

# 意图识别（BERT 主分类 + 关键词兜底）
INTENT_ENABLED=true
INTENT_DEVICE=cpu
INTENT_MAX_LENGTH=64
INTENT_CONFIDENCE_THRESHOLD=0.55
INTENT_MARGIN_THRESHOLD=0.12
INTENT_CACHE_TTL=86400

# 检索与重排序
RETRIEVAL_K=5
CANDIDATE_K=20
RERANK_ENABLED=true
# CPU 上单候选约 1.0~1.3 秒，耗时主要由候选数决定，按机器性能调整
RERANK_CANDIDATE_K=5
RERANK_PASSAGE_CHARS=160
RERANK_MAX_LENGTH=192
# 重排序总预算（秒，含排队）；超时按向量顺序降级；0 表示不限制
RERANK_TIMEOUT_SECONDS=6.0
RERANK_BATCH_SIZE=1
RERANK_SCORE_THRESHOLD=0.25
# drop=重排序失败丢弃资料并记录缺口；vector=显式降级为向量得分
RERANK_FAILURE_MODE=drop
RERANK_MAX_CONSECUTIVE_FAILURES=3
# 同时进行的重排序推理数（CPU 核数有限时保持 1）
RERANK_MAX_CONCURRENT=1

# 多策略检索（规则规划；LLM 选择器默认关闭）
STRATEGY_ENABLED=true
STRATEGY_SELECTOR_LLM_ENABLED=false
STRATEGY_SELECTOR_MODEL=
STRATEGY_TIMEOUT_SECONDS=4.0
STRATEGY_MAX_SUBQUERIES=3
STRATEGY_MAX_QUERY_CHARS=200
STRATEGY_HYDE_MAX_CHARS=240
STRATEGY_CACHE_TTL=3600

# BM25 词法召回（off | fallback | fuse）
BM25_ENABLED=true
BM25_MODE=fuse
BM25_TOP_K=20
BM25_RRF_WEIGHT=0.5
BM25_INDEX_TTL_SECONDS=120
BM25_K1=1.5
BM25_B=0.75
BM25_TITLE_WEIGHT=3.0
BM25_SECTION_WEIGHT=2.0
BM25_CONTENT_WEIGHT=1.0
BM25_MAX_CORPUS_CHUNKS=50000
BM25_MIN_QUERY_COVERAGE=0.4
# 索引容量与并发：超出后按 LRU 淘汰，查询打分在线程池中限流执行
BM25_MAX_TOTAL_CHUNKS=100000
BM25_MAX_INDEXED_KBS=20
BM25_MAX_CONCURRENT_SEARCHES=2

# 多路融合与降级缓存
RRF_K=60
RETRIEVAL_DEGRADED_CACHE_TTL=30

# 缓存（秒）
CACHE_ENABLED=true
ANSWER_CACHE_TTL=300
RETRIEVAL_CACHE_TTL=180
EMBEDDING_CACHE_TTL=86400
# 同一查询并发未命中时只回源一次；TTL 抖动避免缓存同时过期
RETRIEVAL_SINGLEFLIGHT=true
CACHE_TTL_JITTER=0.1

# 可观测与限流
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
# 注册按 IP 独立限流；现场多人同一 NAT 时需调大
RATE_LIMIT_REGISTER_REQUESTS=10
# 允许跨域的前端地址（逗号分隔）；演示域名指向 5173，同源 nginx 部署可留空使用默认值
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 大模型容错
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30

# 并发与背压
MAX_CONCURRENT_LLM=8
# 管理员独立 LLM 通道：普通通道满载时管理员仍可立即生成
LLM_ADMIN_SLOTS=4
MAX_CONCURRENT_EMBEDDING=2
# 排队超过该秒数直接返回“当前咨询较多”，避免请求无限期挂起
LLM_QUEUE_TIMEOUT_SECONDS=5.0
LLM_ADMIN_QUEUE_TIMEOUT_SECONDS=30.0
# bcrypt 在线程池中执行，限制并发避免占满线程池
PASSWORD_HASH_CONCURRENCY=2

# 持久化入库任务与向量 outbox
# 任务/同步条目在 MySQL 中持久化，服务重启后由 worker 继续执行
UPLOAD_TASK_TTL=86400
TASK_MAX_ATTEMPTS=3
# running 状态租约；进程崩溃后超过该时间可由其他 worker 接管
TASK_LEASE_SECONDS=3600
TASK_POLL_SECONDS=2.0
VECTOR_OUTBOX_MAX_ATTEMPTS=5
VECTOR_OUTBOX_LEASE_SECONDS=600

# 会话保留：超过天数未活跃的会话自动归档（0=关闭）
CONVERSATION_RETENTION_DAYS=90
CLEANUP_INTERVAL_SECONDS=86400

# 管理员引导（逗号分隔用户名；启动时置为管理员，留空则不提升）
ADMIN_USERNAMES=

# 评估看板：样本数低于该值的运行只保留在列表中，不计入概览与趋势
# 用于避免 1-3 条冒烟样本把指标抬成 100%
EVAL_MIN_MEANINGFUL_SAMPLES=10

# 安全
JWT_SECRET=please-change-this-secret-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CAPTCHA_TTL_SECONDS=300

# 父子分块与判重（可选，均有默认值）
PARENT_CHUNK_SIZE=1200
DOC_DEDUP_SIMILARITY=0.90
DOC_DEDUP_SIMHASH_MAX_DISTANCE=10
CHUNK_NEAR_DUP_SIMILARITY=0.97
RETRIEVAL_DEDUP_SIMILARITY=0.95

# MinerU 深度解析（Docker）
MINERU_IMAGE=asktofit-mineru:cpu
MINERU_TIMEOUT_SECONDS=900
MINERU_MAX_CONCURRENCY=1
MINERU_MEMORY=8g

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs
