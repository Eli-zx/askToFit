# ===== 多人演示配置（复制为 .env 后按实际环境替换账号密码）=====
# 注册/浏览可到 200 人；同时提问按 20 并发估算，不要按 200 人同时提问配置。
# 启动方式：单 worker，不要使用 --reload
# uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=asktofit
# 200 人同时注册/登录时，SSE 已主动释放连接；20+40 足够
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=10

# Redis / Milvus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
REDIS_DB=0
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=asktofit
MILVUS_COLLECTION=fitrag

# 大模型
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseekv4-flash

# 管理员独立通道：普通通道满载也不会挤占管理员
MAX_CONCURRENT_LLM=16
LLM_ADMIN_SLOTS=4
LLM_QUEUE_TIMEOUT_SECONDS=10
LLM_ADMIN_QUEUE_TIMEOUT_SECONDS=30
# 降低重试放大；首包前失败最多再试一次
LLM_MAX_RETRIES=2

# 重排序：CPU 单次约 5-6 秒，保持 1 路普通 + 1 路管理员
RERANK_MAX_CONCURRENT=1
RERANK_TIMEOUT_SECONDS=6
RERANK_FAILURE_MODE=vector
RERANK_MAX_CONSECUTIVE_FAILURES=3

# 缓存：预热后回答与检索缓存保留 12 小时
CACHE_ENABLED=true
ANSWER_CACHE_TTL=43200
RETRIEVAL_CACHE_TTL=43200
STRATEGY_CACHE_TTL=43200
EMBEDDING_CACHE_TTL=604800
CACHE_TTL_JITTER=0.02
RETRIEVAL_SINGLEFLIGHT=true
BM25_INDEX_TTL_SECONDS=3600

# 限流：现场同一出口 IP 注册 200 人，登录按 IP+用户名
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=30
RATE_LIMIT_REGISTER_REQUESTS=500

# bcrypt 并发：注册高峰时适当放宽，但仍限制线程池占用
PASSWORD_HASH_CONCURRENCY=4

# 预热完成后关闭空闲保活定时器，避免演示期间周期性 CPU 抢占；启动预热仍保留
MODEL_WARMUP_INTERVAL_SECONDS=0

# 跨域：5173 为演示域名指向的端口（构建预览同端口）；nginx 同源部署时可不依赖
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://demo.example.com

# 管理员引导：填写演示管理员用户名，启动时自动提升
ADMIN_USERNAMES=replace-me

# 日志
LOG_LEVEL=INFO
